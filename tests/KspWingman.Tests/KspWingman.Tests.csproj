<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KspWingman.Mcp\KspWingman.Mcp.csproj" />
    <ProjectReference Include="..\..\src\KspWingman.Tui\KspWingman.Tui.csproj" />
    <!-- The bridge's chat numbering has no KSP types, so it's compiled and tested here (the bridge itself is a KSP mod). -->
    <Compile Include="..\..\src\KspWingman.Bridge\ChatLog.cs" Link="ChatLog.cs" />
  </ItemGroup>

</Project>

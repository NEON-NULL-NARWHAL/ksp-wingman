<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MCP server an agent starts (stdio): KSP Wingman's tools, on top of kRPC in the agent's KSP. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.12.1</Version>
    <AssemblyName>KspWingman.Mcp</AssemblyName>
    <RootNamespace>KspWingman.Mcp</RootNamespace>
    <!-- KRPC.Client ships only a .NET Framework build; it works on .NET 10 (LUNA EVO's test rig uses it the same way). -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KRPC.Client" Version="0.7.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KspWingman.Tests" />
  </ItemGroup>

</Project>

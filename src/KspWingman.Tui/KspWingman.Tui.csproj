<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Wingman console: a local model (Ollama, llama.cpp) or any OpenAI-compatible server flies the agent's KSP
       with KspWingman.Mcp's tools, taking orders typed here or said in LMP's chat. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.12.0</Version>
    <AssemblyName>KspWingman</AssemblyName>
    <RootNamespace>KspWingman.Tui</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KspWingman.Tests" />
    <InternalsVisibleTo Include="ModelEval" />
  </ItemGroup>

</Project>
